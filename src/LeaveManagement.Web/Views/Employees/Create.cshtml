@model LeaveManagement.Web.ViewModels.Employee.EmployeeCreateViewModel
@{
    ViewData["Title"] = "Create Employee";
    ViewData["PageName"] = "Employees";
    ViewData["PageTitle"] = "Create Employee";
    ViewData["PageSubtitle"] = "Add a new staff member to the organization.";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card">
            <div class="card-head mb-4">
                <div>
                    <div class="card-title">Employee Details</div>
                    <div class="card-sub">Enter account credentials and personal information.</div>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Name" class="form-control rounded-pill px-3 py-2" placeholder="Full name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Email" type="email" class="form-control rounded-pill px-3 py-2" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Password" type="password" class="form-control rounded-pill px-3 py-2" placeholder="Temporary password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-ink px-4">Create Employee</button>
                    <a asp-action="Index" class="btn btn-outline-ink px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

