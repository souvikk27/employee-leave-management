@model IEnumerable<LeaveManagement.Web.ViewModels.Employee.EmployeeListViewModel>
@{
    ViewData["Title"] = "Employees";
    ViewData["PageName"] = "Employees";
    ViewData["PageTitle"] = "Employees";
    ViewData["PageSubtitle"] = "Directory of all staff members, active status, and leave history.";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-head flex-wrap">
        <div>
            <div class="card-title">All Employees</div>
            <div class="card-sub">Manage employee records, active status, and leave counts.</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-flex align-items-center gap-2">
                <select name="status" class="form-select w-auto" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active" ? "selected" : null)">Active</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive" ? "selected" : null)">Inactive</option>
                </select>
                <span class="search-box">
                    <i class="bi bi-search"></i>
                    <input name="search" value="@ViewBag.Search" placeholder="Search name or email..." />
                </span>
                <button type="submit" class="btn btn-sm btn-outline-ink">Filter</button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Status) || !string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <a asp-action="Index" class="btn btn-sm btn-soft">Clear</a>
                }
            </form>
            <a asp-action="Create" class="btn btn-ink">
                <i class="bi bi-plus-lg me-1"></i>New Employee
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Leave Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-6 d-block mb-2 text-secondary"></i>
                            No employees found matching your criteria.
                        </td>
                    </tr>
                }
                @foreach (var e in Model)
                {
                    <tr>
                        <td>
                            <div class="emp-cell">
                                <div class="emp-avatar d-flex align-items-center justify-content-center fw-semibold text-white bg-dark">
                                    @(string.IsNullOrWhiteSpace(e.Name) ? "?" : e.Name[0].ToString().ToUpper())
                                </div>
                                <div>
                                    <div class="emp-name">@e.Name</div>
                                    <div class="emp-role">Team member</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-secondary">@e.Email</span>
                        </td>
                        <td>
                            @if (e.IsActive)
                            {
                                <span class="badge-pill badge-approved"><span class="badge-dot"></span>Active</span>
                            }
                            else
                            {
                                <span class="badge-pill badge-rejected"><span class="badge-dot"></span>Inactive</span>
                            }
                        </td>
                        <td>
                            <span class="fw-semibold">@e.LeaveCount</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-ink">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                @if (e.IsActive)
                                {
                                    <form asp-action="Deactivate" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-soft text-danger" onclick="return confirm('Are you sure you want to deactivate this employee? Inactive employees cannot submit leave requests.');">
                                            <i class="bi bi-person-x me-1"></i>Deactivate
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-soft" onclick="return confirm('Reactivate this employee? They will be able to log in and submit leave requests again.');">
                                            <i class="bi bi-person-check me-1"></i>Reactivate
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var totalPages = Math.Max(1, ((int)ViewBag.TotalCount + (int)ViewBag.PageSize - 1) / (int)ViewBag.PageSize);
}
<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Page @ViewBag.Page of @totalPages (@ViewBag.TotalCount total)</div>
    <div class="d-inline-flex gap-2">
        @if ((int)ViewBag.Page > 1)
        {
            <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-page="@((int)ViewBag.Page - 1)" class="btn btn-sm btn-outline-ink">Previous</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-ink" disabled>Previous</button>
        }
        @if ((int)ViewBag.Page < totalPages)
        {
            <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-page="@((int)ViewBag.Page + 1)" class="btn btn-sm btn-outline-ink">Next</a>
        }
        else
        {
            <button class="btn btn-sm btn-outline-ink" disabled>Next</button>
        }
    </div>
</div>

