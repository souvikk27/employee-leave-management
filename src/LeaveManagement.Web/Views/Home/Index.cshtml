@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageName"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubtitle"] = "Overview of leave management activity.";
    ViewData["ShowNewRequest"] = true;
}

<!-- Stats Row -->
<div class="row g-3 mb-3">
    <div class="col-md-6 col-xl-3">
        <div class="card card-emphasis h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Pending approvals</span>
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            </div>
            <div class="stat-value mt-3">12</div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="stat-trend">
                    <span class="delta accent"><i class="bi bi-arrow-up-short"></i>3</span>
                    <span>vs. yesterday</span>
                </div>
                <div class="spark">
                    <span style="height:30%"></span><span style="height:50%"></span><span style="height:40%"></span><span style="height:70%"></span><span style="height:55%"></span><span style="height:85%"></span><span style="height:100%" class="peak"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Approved this month</span>
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
            </div>
            <div class="stat-value mt-3">48</div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="stat-trend">
                    <span class="delta"><i class="bi bi-arrow-up-short"></i>11%</span>
                    <span>vs. last month</span>
                </div>
                <div class="spark">
                    <span style="height:45%"></span><span style="height:55%"></span><span style="height:65%"></span><span style="height:50%"></span><span style="height:75%"></span><span style="height:70%"></span><span style="height:90%" class="peak"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">On leave today</span>
                <div class="stat-icon"><i class="bi bi-person-check"></i></div>
            </div>
            <div class="stat-value mt-3">7</div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="stat-trend">
                    <span class="delta"><i class="bi bi-dash"></i>2</span>
                    <span>vs. yesterday</span>
                </div>
                <div class="spark">
                    <span style="height:60%"></span><span style="height:80%"></span><span style="height:70%"></span><span style="height:90%"></span><span style="height:65%"></span><span style="height:55%"></span><span style="height:50%" class="peak"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Total workforce</span>
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            </div>
            <div class="stat-value mt-3">248</div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="stat-trend">
                    <span class="delta"><i class="bi bi-arrow-up-short"></i>4</span>
                    <span>new hires this month</span>
                </div>
                <div class="spark">
                    <span style="height:70%"></span><span style="height:72%"></span><span style="height:75%"></span><span style="height:80%"></span><span style="height:85%"></span><span style="height:92%"></span><span style="height:100%" class="peak"></span>
                </div>
            </div>
        </div>
    </div>
</div>

