                            <td><span class="badge-pill badge-action"><span class="badge-dot"></span>Action needed</span></td>
                            <td>
                                <div class="row-actions">
                                    <button class="btn-action reject"><i class="bi bi-x-lg"></i></button>
                                    <button class="btn-action approve"><i class="bi bi-check-lg"></i></button>
