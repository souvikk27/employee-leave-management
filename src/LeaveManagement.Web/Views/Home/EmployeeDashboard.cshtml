@model LeaveManagement.Web.ViewModels.Dashboard.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageName"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubtitle"] = "Your leave summary and recent requests.";
}

<div class="row g-3 mb-3">
    <div class="col-md-6 col-xl-3">
        <div class="card card-emphasis h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Pending</span>
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            </div>
            <div class="stat-value mt-3">@Model.PendingRequests</div>
            <div class="stat-trend mt-2"><span>awaiting review</span></div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Approved</span>
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
            </div>
            <div class="stat-value mt-3">@Model.ApprovedRequests</div>
            <div class="stat-trend mt-2"><span>of @Model.TotalRequests total</span></div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Rejected</span>
                <div class="stat-icon"><i class="bi bi-x-circle"></i></div>
            </div>
            <div class="stat-value mt-3">@Model.RejectedRequests</div>
            <div class="stat-trend mt-2"><span>of @Model.TotalRequests total</span></div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">New request</span>
                <div class="stat-icon"><i class="bi bi-plus-circle"></i></div>
            </div>
            <div class="mt-3">
                <a asp-controller="Leaves" asp-action="Apply" class="btn btn-ink w-100">
                    <i class="bi bi-plus-lg me-1"></i>Apply for Leave
                </a>
            </div>
            <div class="stat-trend mt-2">
                <a asp-controller="Leaves" asp-action="Index">View full history</a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head flex-wrap">
        <div>
            <div class="card-title">Recent requests</div>
            <div class="card-sub">Your latest leave activity.</div>
        </div>
        <a asp-controller="Leaves" asp-action="Index" class="btn btn-outline-ink">My Leaves</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>From</th>
                    <th>To</th>
                    <th>Reason</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentLeaves.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-6 d-block mb-2 text-secondary"></i>
                            No leave requests yet.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.RecentLeaves)
                {
                    <tr>
                        <td>@item.FromDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.ToDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Reason</td>
                        <td>
                            @if (item.Status == "Approved")
                            {
                                <span class="badge-pill badge-approved"><span class="badge-dot"></span>Approved</span>
                            }
                            else if (item.Status == "Pending")
                            {
                                <span class="badge-pill badge-pending"><span class="badge-dot"></span>Pending</span>
                            }
                            else
                            {
                                <span class="badge-pill badge-rejected"><span class="badge-dot"></span>Rejected</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
