@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Avery Chen";
    var userRole = User.Identity?.IsAuthenticated == true
        ? (User.IsInRole("Admin") ? "HR administrator" : "Employee")
        : "HR administrator";
}

<aside class="sidebar">
    <div class="brand">
        <div class="brand-mark">M</div>
        <div class="brand-text">
            <span class="brand-name">Mobbin</span>
            <span class="brand-sub">Leave admin</span>
        </div>
    </div>

    <div class="nav-section">
        <div class="nav-section-label">Overview</div>
        <a asp-controller="Home" asp-action="Index"
           class="nav-item @(controller == "Home" && action == "Index" ? "active" : "")"
           data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
            <i class="bi bi-grid-1x2-fill"></i>
            <span class="nav-text">Dashboard</span>
        </a>
    </div>

    @if (User.IsInRole("Employee"))
    {
        <div class="nav-section">
            <div class="nav-section-label">Leave</div>
            <a asp-controller="Leaves" asp-action="Index"
               class="nav-item @(controller == "Leaves" ? "active" : "")"
               data-bs-toggle="tooltip" data-bs-placement="right" title="My Leaves">
                <i class="bi bi-calendar-check"></i>
                <span class="nav-text">My Leaves</span>
            </a>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="nav-section">
            <div class="nav-section-label">Leave</div>
            <a asp-controller="LeaveReviews" asp-action="Index"
               class="nav-item @(controller == "LeaveReviews" ? "active" : "")"
               data-bs-toggle="tooltip" data-bs-placement="right" title="Leave Requests">
                <i class="bi bi-calendar-check"></i>
                <span class="nav-text">Leave Requests</span>
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-section-label">People</div>
            <a asp-controller="Employees" asp-action="Index"
               class="nav-item @(controller == "Employees" ? "active" : "")"
               data-bs-toggle="tooltip" data-bs-placement="right" title="Employees">
                <i class="bi bi-people"></i>
                <span class="nav-text">Employees</span>
            </a>
        </div>
    }

    <div class="sidebar-footer">
        <div class="user-card" data-bs-toggle="tooltip" data-bs-placement="right" title="@userName">
            <img class="avatar" src="https://i.pravatar.cc/64?img=12" alt="@userName" />
            <div class="user-meta">
                <div class="user-name">@userName</div>
                <div class="user-role">@userRole</div>
            </div>
            <i class="bi bi-three-dots-vertical"></i>
        </div>
    </div>
</aside>
