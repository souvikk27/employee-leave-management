<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Leave Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-shell" id="appShell">

        <partial name="_Sidebar" />

        <main class="main">

            <partial name="_Topbar" />

            <div class="container-fluid px-0">
                @RenderBody()
            </div>

        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;" id="notifToastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.IsInRole("Employee"))
    {
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script>
            (function () {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/leave-notifications")
                    .withAutomaticReconnect()
                    .build();

                function showLeaveToast(status, reviewedAt, reviewedByEmail) {
                    const container = document.getElementById("notifToastContainer");
                    if (!container) return;

                    const when = new Date(reviewedAt).toLocaleString(undefined, {
                        dateStyle: "medium",
                        timeStyle: "short",
                    });

                    const el = document.createElement("div");
                    el.className = "toast leave-toast align-items-center border-0";
                    el.setAttribute("role", "alert");

                    const flex = document.createElement("div");
                    flex.className = "d-flex";

                    const body = document.createElement("div");
                    body.className = "toast-body";
                    body.textContent = status + " by " + reviewedByEmail + " on " + when + ".";

                    const closeBtn = document.createElement("button");
                    closeBtn.type = "button";
                    closeBtn.className = "btn-close btn-close-white me-2 m-auto";
                    closeBtn.setAttribute("data-bs-dismiss", "toast");
                    closeBtn.setAttribute("aria-label", "Close");

                    flex.appendChild(body);
                    flex.appendChild(closeBtn);
                    el.appendChild(flex);
                    container.appendChild(el);

                    const toast = new bootstrap.Toast(el, { delay: 6000 });
                    el.addEventListener("hidden.bs.toast", function () { el.remove(); });
                    toast.show();
                }

                connection.on("LeaveReviewed", function (payload) {
                    showLeaveToast(payload.status, payload.reviewedAt, payload.reviewedByEmail);
                    var path = location.pathname.toLowerCase();
                    if (path === "/" || path.startsWith("/leaves")) {
                        setTimeout(function () { location.reload(); }, 4000);
                    }
                });

                connection.start().catch(function (err) {
                    console.error("Leave notification connection failed", err);
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
