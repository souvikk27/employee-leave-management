<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Leave Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: var(--colors-canvas); }
        .auth-wrapper { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
        .auth-form-side { display: flex; flex-direction: column; justify-content: center; padding: 48px; }
        .auth-form-container { width: 100%; max-width: 380px; margin: 0 auto; }
        .auth-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 64px; text-decoration: none; }
        .auth-title { font-size: 32px; font-weight: 650; line-height: 1.13; letter-spacing: -0.01em; color: var(--colors-ink); margin-bottom: 8px; }
        .auth-subtitle { font-size: 16px; font-weight: 300; color: var(--colors-text-muted); margin-bottom: 32px; line-height: 1.38; }
        .form-label-custom { font-size: 13px; font-weight: 600; color: var(--colors-ink); margin-bottom: 6px; display: block; }
        .form-input-custom { width: 100%; background: var(--colors-field); border: 1px solid transparent; border-radius: 16px; padding: 14px 16px; font-size: 15px; color: var(--colors-ink); transition: all 0.15s; }
        .form-input-custom::placeholder { color: var(--colors-text-faint); }
        .form-input-custom:focus { outline: none; background: var(--colors-canvas); border-color: var(--colors-ink); box-shadow: 0 0 0 2px var(--colors-ink); }
        .ink-btn-full { width: 100%; background: var(--colors-ink); color: var(--colors-on-primary); border: none; border-radius: 9999px; padding: 12px 18px; font-size: 14px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; transition: background 0.15s; }
        .ink-btn-full:hover { background: var(--colors-ink-soft); }
        .auth-foot { margin-top: 32px; text-align: center; font-size: 13px; color: var(--colors-text-faint); font-weight: 450; }
        .auth-visual-side { background: var(--colors-ink); display: flex; align-items: center; justify-content: center; padding: 48px; position: relative; overflow: hidden; }
        .auth-visual-content { max-width: 400px; color: var(--colors-on-primary); }
        .auth-visual-heading { font-size: 32px; font-weight: 652; line-height: 1.13; margin-bottom: 16px; }
        .auth-visual-body { font-size: 16px; font-weight: 300; line-height: 1.38; color: rgba(255, 255, 255, 0.64); margin-bottom: 40px; }
        .auth-icon-row { display: flex; gap: 12px; }
        .auth-icon-sq { width: 56px; height: 56px; border-radius: 30%; background: rgba(255, 255, 255, 0.08); display: grid; place-items: center; color: var(--colors-on-primary); font-size: 22px; }
        @@media (max-width: 900px) { .auth-wrapper { grid-template-columns: 1fr; } .auth-visual-side { display: none; } .auth-form-side { padding: 24px; min-height: 100vh; justify-content: flex-start; padding-top: 80px; } }
    </style>
</head>
<body>
<div class="auth-wrapper">
    <div class="auth-form-side">
        <div class="auth-form-container">
            <a href="/" class="auth-brand">
                <div class="brand-mark">M</div>
                <div class="brand-text">
                    <span class="brand-name" style="color: var(--colors-ink);">Leave Management</span>
                </div>
            </a>
            @RenderBody()
        </div>
    </div>
    <div class="auth-visual-side">
        <div class="auth-visual-content">
            <div class="auth-visual-heading">Leave, tracked in one place.</div>
            <p class="auth-visual-body">Apply for time off, review requests, and see approval status without leaving your workspace.</p>
            <div class="auth-icon-row">
                <div class="auth-icon-sq"><i class="bi bi-calendar-check"></i></div>
                <div class="auth-icon-sq"><i class="bi bi-hourglass-split"></i></div>
                <div class="auth-icon-sq"><i class="bi bi-check-circle"></i></div>
                <div class="auth-icon-sq"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
