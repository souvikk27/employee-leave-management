@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["PageName"] = "Error";
    ViewData["PageTitle"] = "An error occurred";
    ViewData["PageSubtitle"] = "An error occurred while processing your request.";
    ViewData["HideNewRequest"] = true;
}

<div class="card">
    <div class="card-head">
        <div>
            <h2 class="card-title text-danger">Request Error</h2>
            <div class="card-sub">Please try again or contact system support.</div>
        </div>
    </div>
    <div class="card-body px-0">
        @if (Model.ShowRequestId)
        {
            <div class="alert alert-danger mb-3">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </div>
        }
        <p class="text-muted">
            If this issue persists, please reach out to your administrator.
        </p>
    </div>
</div>
